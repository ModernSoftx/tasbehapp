<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sound Debugging Tool"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="24dp"
        android:gravity="center"/>

    <Button
        android:id="@+id/btnTestClick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test Click Sound"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnTestSuccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test Success Sound"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnTestReset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test Reset Sound"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Debug Logs:"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvDebugLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Logs appear here..."
            android:textSize="12sp"
            android:textColor="#222222"/>
    </ScrollView>

    <Button
        android:id="@+id/btnClearLogs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Clear Logs"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        style="?attr/borderlessButtonStyle"/>

</LinearLayout>
